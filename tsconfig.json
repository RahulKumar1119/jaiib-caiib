{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "declaration": true,
    "outDir": "./lib",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "/opt/nodejs/*": ["infrastructure/lambda-layers/utility-functions/src/*"]
    }
  },
  "include": ["src/**/*", "infrastructure/lambda-layers/utility-functions/src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts", "lib", "dist"]
}
