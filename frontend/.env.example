# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=JAIIB-CAIIB Exam Prep Portal
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_LOG_LEVEL=info

# Authentication
NEXT_PUBLIC_SESSION_TIMEOUT=1800
NEXT_PUBLIC_TOKEN_STORAGE_KEY=session_token
NEXT_PUBLIC_REFRESH_TOKEN_STORAGE_KEY=refresh_token

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=true
